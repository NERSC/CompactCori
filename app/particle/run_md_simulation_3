#         This research used resources of the National Energy Research
#         Scientific Computing Center, which is supported by the Office
#         of Science of the U.S. Department of Energy.
#
# Update History:
# YYYY-MM-DD INITIALS - DESCRIPTION
# *****************************************************************************
# 2015-08-12 NF       - Wrote initial script

PROG=$(basename $0)

error() {
    echo -e "ERROR: $*" >&2
    exit 1
}

usage() {
    echo "USAGE: $PROG [num_tasks] [num_particlecs]"

}

test $# -ne 2 && error "too few arguments" && usage

mpi_host_file='../../mpihostsfile'

# if there is a nonempty string within the brackets, then perform rsync
# otherwise, do not perform rsync
if [ "yes" ]; then
    while read line; do
        ip_addr=$(echo $line | tr -d [:space:] | cut -d '#' -f1)
        if [ -n "$ip_addr" ]; then
            echo '------------------------------------------------------------------------------------------'
            echo "attempting rsync to $ip_addr"
            rsync -aPvz --delete --rsync-path="mkdir -p ~/CompactCori && rsync" ~/CompactCori/ $ip_addr:~/CompactCori
            echo '------------------------------------------------------------------------------------------'
        fi
    done < "$mpi_host_file"
else
    echo 'no rsync'
fi

mpirun --hostfile "$mpi_host_file" -np $1 --npernode 1 python3 "./particle_simulation.py" -n $2
