#         This work was supported by the Director, Office of Science,
#         Division of Mathematical, Information, and Computational
#         Sciences of the U.S. Department of Energy under contract
#         DE-AC02-05CH11231.
#
#         This research used resources of the National Energy Research
#         Scientific Computing Center, which is supported by the Office
#         of Science of the U.S. Department of Energy.
#
# Update History:
# YYYY-MM-DD INITIALS - DESCRIPTION
# *****************************************************************************
# 2015-08-12 NF       - Wrote initial script

PROG=$(basename $0)

error() {
    echo -e "ERROR: $*" >&2
    usage
    exit 1
}

usage() {
    echo "USAGE: $PROG [num_tasks] [num_particles]" >&2
}

test $# -ne 2 && error "must have exactly two arguments"

MPI_HOST_FILE='/home/ccori/mpihostfile'

while read line; do
    ip_addr=$(echo $line | tr -d [:space:] | cut -d '#' -f1)
    if [ -n "$ip_addr" ]; then
        echo '------------------------------------------------------------------------------------------'
        echo "attempting rsync to $ip_addr"
        rsync -aPvz --delete --rsync-path="mkdir -p ~/CompactCori && rsync" ~/CompactCori/ $ip_addr:~/CompactCori
        if [ $? -eq 0 ]; then
            echo "rsync successful"
        else
            echo "rsync failed"
        fi
        echo '------------------------------------------------------------------------------------------'
    fi
done < $MPI_HOST_FILE

mpirun --hostfile $MPI_HOST_FILE -np $1 --npernode 1 python3 "./particle_simulation.py" -n $2
