#!/bin/bash
#
# setup_script_common: set up a node in the Compact Cori cluster with the assumptions that:
#     - the node has a clean Ubuntu 16.04 LTS installation
#     - the node's computer name is CompactCori<node_index>, where node_index is a non negative integer
#     - the node's user name is ccori
#     - the node does NOT have blink(1) usb status light plugged into it
#     - the node has internet access
#     - this script is with sudo
#
# Usage: sudo ./setup_script_common

declare -r script_name="$(basename $BASH_SOURCE)"

error() {
    echo -e "ERROR: $*" >&2
}

usage() {
    echo "USAGE: sudo ./${script_name}" >&2
}

if [[ "${USER}" != root ]]; then
    error 'the execution of this script requires root privileges'
    usage
    exit 1
fi

if [[ ! "$(hostname)" =~ ^CompactCori[[:digit:]]+$ ]]; then
    error 'the hostname is not in the correct format; please change it to CompactCori<node_index>'
    exit 2
fi

declare -i -r node_id="$(hostname | tr --delete [:alpha:])"

if [[ "${node_id}" -eq 1 ]]; then
    wget -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | sudo apt-key add -
    sh -c 'echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google-chrome.list'
fi
apt update
apt --assume-yes full-upgrade
apt --assume-yes install checkinstall git libopenmpi-dev libusb-1.0 openssh-server python3-mpi4py
if [[ "${node_id}" -eq 1 ]]; then
    apt --assume-yes install apt-cacher-ng clusterssh google-chrome-stable libnss3-tools nmap sshpass vim
fi

ufw enable
ufw allow in on enp0s25 to any

rm --force --recursive /home/ccori/.ssh

su --login ccori << \END
    ssh-keygen -f /home/ccori/.ssh/id_rsa -N ''

    git clone https://github.com/todbot/blink1.git

    git clone https://github.com/amix/vimrc.git /home/ccori/.vim_runtime
    sh /home/ccori/.vim_runtime/install_awesome_vimrc.sh
END

cd /home/ccori/blink1/commandline
checkinstall --default
cp /home/ccori/blink1/linux/51-blink1.rules /etc/udev/rules.d
udevadm control --reload

cp /etc/network/interfaces{,.bak}
cat > /etc/network/interfaces << END
# interfaces(5) file used by ifup(8) and ifdown(8)
auto lo
iface lo inet loopback

auto enp0s25
iface enp0s25 inet static
address 10.0.0.$((100 + node_id))
END

if [[ "${node_id}" -ne 1 ]]; then
    echo 'Acquire::http::Proxy "http://10.0.0.101:3142";' > /etc/apt/apt.conf.d/01proxy
fi

shutdown --reboot now
